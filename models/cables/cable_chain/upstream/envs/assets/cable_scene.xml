<mujoco model="cable_insertion">
  <option gravity="0 0 -9.81" timestep="0.001"/>
  <worldbody>
    <light pos="0 0 2" dir="0 0 -1"/>
    <light pos="0.3 0.3 0.5" dir="-0.3 -0.3 -1" diffuse="0.4 0.4 0.4"/>
    <geom type="plane" size="0.5 0.5 0.01" rgba="0.3 0.3 0.3 1"/>

    <!-- Fixed cameras -->
    <camera name="overhead" pos="0.15 0 0.45" xyaxes="1 0 0 0 1 0"/>
    <camera name="side" pos="0.3 0 0.2" xyaxes="0 1 0 -0.5 0 1" fovy="60"/>

    <body name="socket" pos="0.18 0 0.04">
      <geom type="cylinder" size="0.02 0.015" rgba="0.2 0.6 0.2 1" contype="0" conaffinity="0"/>
    </body>
    <body name="gripper" pos="0.1 0 0.2">
      <joint name="x" type="slide" axis="1 0 0" range="-0.3 0.3"/>
      <joint name="y" type="slide" axis="0 1 0" range="-0.3 0.3"/>
      <joint name="z" type="slide" axis="0 0 1" range="-0.2 0.4"/>

      <!-- Wrist camera: moves with gripper, looks down along cable -->
      <camera name="wrist" pos="0 0 -0.02" xyaxes="1 0 0 0 1 0" fovy="90"/>

      <geom type="box" size="0.02 0.02 0.015" rgba="0.5 0.5 0.5 1"/>
      <body name="seg1" pos="0 0 -0.03">
        <joint type="ball" damping="0.2" stiffness="0.1"/>
        <geom type="capsule" size="0.008" fromto="0 0 0 0 0 -0.03" rgba="0.9 0.4 0.1 1"/>

        <body name="seg2" pos="0 0 -0.03">
          <joint type="ball" damping="0.2" stiffness="0.1"/>
          <geom type="capsule" size="0.008" fromto="0 0 0 0 0 -0.03" rgba="0.9 0.4 0.1 1"/>

          <body name="seg3" pos="0 0 -0.03">
            <joint type="ball" damping="0.2" stiffness="0.1"/>
            <geom type="capsule" size="0.008" fromto="0 0 0 0 0 -0.03" rgba="0.9 0.4 0.1 1"/>

            <body name="seg4" pos="0 0 -0.03">
              <joint type="ball" damping="0.2" stiffness="0.1"/>
              <geom type="capsule" size="0.008" fromto="0 0 0 0 0 -0.03" rgba="0.9 0.4 0.1 1"/>

              <body name="connector" pos="0 0 -0.03">
                <joint type="ball" damping="0.2" stiffness="0.1"/>
                <geom type="cylinder" size="0.015 0.02" rgba="0.3 0.3 0.8 1"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position joint="x" kp="500"/>
    <position joint="y" kp="500"/>
    <position joint="z" kp="500"/>
  </actuator>
  <sensor>
    <framepos objtype="body" objname="connector" name="connector_pos"/>
    <framepos objtype="body" objname="gripper" name="gripper_pos"/>
  </sensor>
</mujoco>
